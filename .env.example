# Neon Postgres connection string (Neon console → Connect → pooled connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth — generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-32+-character-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL (used by the Better Auth client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
